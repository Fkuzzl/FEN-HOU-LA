# Copy values into your shell or a local, untracked environment file.
# PUBLIC_ORIGIN is the browser origin, not the API URL.
PUBLIC_ORIGIN=http://localhost:55173
PUBLIC_COOKIE_SECURE=false
PUBLIC_TRUSTED_HOSTS=localhost,127.0.0.1
PUBLIC_JWT_SECRET=replace-with-a-random-secret
STORAGE_PROVIDER=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<server-only-access-key>
R2_SECRET_ACCESS_KEY=<server-only-secret>
R2_BUCKET=fen-hou-la-receipts
